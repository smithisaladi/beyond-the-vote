NEXT_PUBLIC_SUPABASE_URL=your-supabase-project-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Congress.gov API — https://api.congress.gov/sign-up/
CONGRESS_API_KEY=your-congress-api-key

# Google APIs (Geocoding + Civic Information) — https://console.cloud.google.com/
# Enable: Civic Information API, Geocoding API
GOOGLE_API_KEY=your-google-api-key

# OpenSecrets API — https://www.opensecrets.org/api/admin/index.php
# Optional: enables top donor data on politician profiles
OPENSECRETS_API_KEY=your-opensecrets-api-key

